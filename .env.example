# StudyPal Environment Configuration

# Application
APP_ENV=development
DEBUG=True
API_V1_PREFIX=/api/v1
SECRET_KEY=change_this_to_a_super_secure_random_key_in_production_32chars_min!
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (Default: SQLite for local zero-config development; can switch to PostgreSQL)
DATABASE_URL=sqlite:///./studypal.db
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/studypal

# Storage
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_BYTES=26214400  # 25 MB
ALLOWED_EXTENSIONS=["pdf", "txt"]

# Ingestion & Chunking
CHUNK_TARGET_WORDS=200
CHUNK_MIN_WORDS=30
CHUNK_MAX_WORDS=400
CHUNK_OVERLAP_WORDS=30

# Content Engine & Retrieval
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
MODEL_CACHE_DIR=./models/cache
RETRIEVAL_METHOD=hybrid
HYBRID_ALPHA=0.5  # Weight for TF-IDF vs Semantic (0.5 = 50% TF-IDF, 50% Embedding)
TOP_K_RETRIEVAL=5

# Topic Discovery (K-Means)
MIN_CHUNKS_FOR_CLUSTERING=4
DEFAULT_N_CLUSTERS=3
CLUSTERING_RANDOM_STATE=42

# Learner Engine - Bayesian Knowledge Tracing (BKT)
BKT_P_L0=0.2    # Initial probability of knowing
BKT_P_T=0.15    # Probability of learning on opportunity
BKT_P_G=0.25    # Guess probability
BKT_P_S=0.10    # Slip probability

# Learner Engine - Weakness Classifier
MIN_SAMPLES_FOR_TRAINING=20

# Recommendation Engine Weights
REC_WEIGHT_MASTERY=0.5
REC_WEIGHT_WEAKNESS=0.3
REC_WEIGHT_RECENCY=0.2

# CORS
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]
